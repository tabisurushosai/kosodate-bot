# kosodate-bot environment variables
# Copy this file to .env.local and replace every placeholder with real values.
# .env.local is intentionally ignored by git.

# === App URL / Auth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
CRON_SECRET=replace-with-vercel-cron-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=replace-with-smtp-user
EMAIL_SERVER_PASSWORD=replace-with-smtp-password
EMAIL_FROM="Kosodate Bot <no-reply@example.com>"

# === Claude (AI consultation engine) ===
ANTHROPIC_API_KEY=sk-ant-replace-with-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

# === Supabase (Auth + Database) ===
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# === Vercel KV (consultation history / usage storage) ===
KV_REST_API_URL=https://replace-with-kv-url.upstash.io
KV_REST_API_TOKEN=replace-with-kv-rest-api-token

# === Stripe (subscriptions) ===
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
STRIPE_PRICE_ID=price_replace-with-monthly-subscription-price-id
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-stripe-publishable-key
